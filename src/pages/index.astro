---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles.css';
import Mark from '../Mark.astro';
import Role from '../Role.astro';
import { fetchActivity, gridHTML, todayLine, type Activity } from '../github';
import { site, links, flags, proof, work, lab, services, experience, education, awards, internshipLine, now } from '../data';

const fav = (url: string) => `https://www.google.com/s2/favicons?domain=${new URL(url).hostname}&sz=32`;
const mail = `mailto:${links.email}`;
// GitHub calendar (rolling year to today), rendered at build; the page refreshes it from /api/github.
const gh: Activity = await fetchActivity(flags.githubLogin).catch(() => ({ total: 0, days: [] }));
const liveCount = work.filter((w) => w.tags.includes('Live')).length;
// Fluent Emoji 3D (MIT). Hover lifts a sticker; with sounds on, the row plays like a xylophone.
const stickers: [string, string, string?][] = [
  ['graduation_cap', 'B.Tech CS & AI, Newton School'],
  ['laptop', 'Where it all happens'],
  ['robot', 'NewtonClaw', links.newtonclaw],
  ['trophy', '1st place, MCP Challenge'],
  ['brain', 'AI agents and MCP'],
  ['pill', 'myRxSetu', 'https://myrxsetu.com'],
  ['receipt', 'GST invoices, done right'],
  ['fire', 'BlazeEats', 'https://blazeeats.in'],
  ['motor_scooter', 'Rider app, on the road'],
  ['notebook', '24,000 SKUs at KR Stationers'],
  ['package', 'Shipped to npm'],
  ['house', 'ResolvHome'],
  ['speech_balloon', 'Chatter'],
  ['bug', 'Bugs squashed: lots'],
  ['hot_beverage', 'Fuel: chai'],
  ['tractor', 'Made in Haryana'],
  ['crescent_moon', 'Late-night deploys'],
  ['rocket', 'Next: your team?', '#contact'],
];
const rot = [-8, 6, -4, 9, -6, 3, -10, 5, -3, 8, -7, 4, -9, 6, -2, 7, -5, 10];
const wa = links.whatsapp && `https://wa.me/${links.whatsapp}`;
const textLinks = [
  ['GitHub', links.github],
  ['LinkedIn', links.linkedin],
  ['X', links.x],
  ['Email', mail],
  ['Book a call', links.cal],
].filter(([, u]) => u);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.short,
  jobTitle: 'Software engineer',
  description: site.description,
  url: site.url,
  image: `${site.url}/avatar.jpg`,
  email: links.email,
  address: { '@type': 'PostalAddress', addressRegion: 'Haryana', addressCountry: 'IN' },
  worksFor: { '@type': 'Organization', name: 'Dhivio', ...(links.dhivio && { url: links.dhivio }) },
  alumniOf: { '@type': 'CollegeOrUniversity', name: education[0].org },
  award: '1st place, Newton School MCP Challenge',
  sameAs: [links.github, links.linkedin, links.x, links.instagram, links.wikidata, links.dhivio].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.url + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FBFBFA" />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={site.url + '/'} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={site.url + '/og.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {links.analyticsToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: links.analyticsToken })} />}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
        document.querySelector('meta[name=theme-color]').content = '#0E0E0E';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="top">
      <a class="wordmark" href="/" aria-label="Dikshant Jangra, home"><Mark /></a>
      <div class="top-right">
        <span class="mono muted" id="here" hidden></span>
        <span class="views" id="views" hidden title="Unique visitors, each counted once" aria-label="unique visitors"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg><span id="views-n"></span></span>
        <span class="mono muted" id="clock">Haryana · --:-- IST</span>
        <button class="icon-btn" id="theme" type="button" aria-label="Toggle dark mode">◐</button>
        <button class="kbd-btn" id="k" type="button" aria-label="Open command menu" aria-keyshortcuts="Control+K Meta+K"><kbd id="k-mod">Ctrl</kbd><kbd>K</kbd></button>
      </div>
    </header>

    <main id="main">
      <div class="hero" id="hero">
        <svg class="sig" viewBox="0 0 240 115" fill="none" aria-hidden="true">
          <path style="--d:1.4s;--s:0.9s" pathLength="1" d="M18 34C26 28 34 24 42 22C40 46 35 70 28 92C26 98 21 96 23 89C30 62 58 20 90 30C114 38 106 74 78 86C62 93 44 93 31 88" />
          <path style="--d:2.35s;--s:0.25s" pathLength="1" d="M118 34C134 27 156 22 176 24" />
          <path style="--d:2.65s;--s:0.85s" pathLength="1" d="M154 25C152 54 146 80 133 97C123 109 104 107 106 95C108 83 132 77 156 81C182 85 208 72 232 44" />
        </svg>
        <img class="avatar" src="/avatar.jpg" alt="Dikshant Jangra" width="64" height="64" fetchpriority="high" />
        <p class="mono muted">hey, I'm DJ</p>
        <h1>D<span class="i-dot">i<span class="rig" aria-hidden="true"><span class="tittle"></span></span></span>kshant Jangra<svg class="verified" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M23 12l-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.69 3.1 5.5l.34 3.7L1 12l2.44 2.79-.34 3.7 3.61.82L8.6 22.5l3.4-1.47 3.4 1.46 1.89-3.19 3.61-.82-.34-3.69L23 12z" /><path class="tick" d="M7.5 12.2l3 3 6-6.2" /></svg></h1>
        <p class="role">{site.age} · Software engineer · {site.location}</p>
        <p>I build <span class="hl">production software end to end</span>: the database, the API, the apps and the AI layer on top. Then I run it. The stack I built for <a class="fav" href="https://blazeeats.in"><img src="/logos/blazeeats.png" alt="" width="14" height="14" />BlazeEats</a> takes hundreds of orders a day across its storefront, kitchen, rider and HQ apps.</p>
        <p>
          I won the <span class="hl">Newton School MCP Challenge</span>, <span class="hl thin">1st among 3 winners across 3 campuses</span>, with <a class="fav" href={links.newtonclaw}><img src={fav(links.newtonclaw)} alt="" width="14" height="14" />NewtonClaw</a>, an AI agent that runs one brain behind a CLI and a Telegram bot. <span class="hl mark">The prize: a year of <a class="fav" href="https://claude.ai"><img src="/logos/claude.png" alt="" width="14" height="14" />Claude Pro</a></span>. B.Tech in CS &amp; AI at Newton School of Technology.
        </p>
        <div class="buttons">
          <a class="btn btn-primary" href={links.resume}>View resume</a>
          <a class="btn btn-secondary" href={mail}>Email me</a>
        </div>
        <nav class="textlinks" aria-label="Profiles">
          {textLinks.map(([name, url]) => <a class="fav" href={url}>{url.startsWith('http') && <img src={fav(url)} alt="" width="14" height="14" loading="lazy" />}{name}</a>)}
        </nav>
        <p class="proof mono">{proof.join(' · ')}</p>
      </div>

      <section id="experience">
        <p class="label">Work</p>
        <ul class="roles">
          {experience.map((e) => <li><Role name={e.org} sub={e.role} when={e.dates} url={e.url} icon={e.icon} /></li>)}
        </ul>
        <p class="label sub-label">Education &amp; awards</p>
        <ul class="roles">
          {education.map((e) => <li><Role name={e.org.split(',')[0]} sub={e.role} when={e.dates} url="https://www.newtonschool.co" /></li>)}
          {awards.map((a) => <li><Role name={a.role.split(' — ')[1] ?? a.role} sub={a.note} when={a.dates} url={links.newtonclaw} icon="/stickers/trophy.png" /></li>)}
        </ul>
        <p class="meta" style="margin-top:16px">{internshipLine} <a href={links.resume}>Resume →</a></p>
      </section>

      <section id="work">
        <p class="label">Projects</p>
        <p class="intro">Shipped and running, with real users, real money and real constraints.</p>
        <ul class="rows">
          {work.map((w) => (
            <li>
              <a class="row" href={w.url || undefined}>
                <span class="logo" aria-hidden="true">{w.url ? <img src={w.icon ?? fav(w.url)} alt="" width="18" height="18" loading="lazy" /> : w.name[0]}</span>
                <div>
                  <div class="row-head"><strong>{w.name}</strong>{w.tags.map((t) => <span class:list={['tag', t]}>{t}</span>)}</div>
                  <p>{w.oneLiner}</p>
                  <p class="meta">{w.detail}</p>
                  <div class="chips">{w.stack.map((s) => <span class="chip">{s}</span>)}</div>
                </div>
                {w.url && <span class="arrow" aria-hidden="true">→</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="github">
        <div class="gh-head">
          <p class="label">GitHub activity</p>
          <p class="gh-today" id="gh-today" set:html={gh.days.length ? todayLine(gh) : ''} />
        </div>
        <div class="gh-scroll" id="gh-scroll">
          <div class="gh-grid" id="gh-grid" role="img" aria-label={`${gh.total} GitHub contributions in the last year`} set:html={gridHTML(gh)} />
        </div>
        <div class="gh-foot">
          <a href={links.github}><span id="gh-total">{gh.total.toLocaleString('en-US')}</span> contributions in the last year</a>
          <span class="gh-legend" aria-hidden="true">Less <i data-l="0"></i><i data-l="1"></i><i data-l="2"></i><i data-l="3"></i><i data-l="4"></i> More</span>
        </div>
      </section>

      <section id="lab">
        <p class="label">Lab</p>
        <p class="intro">Smaller things and experiments.</p>
        <ul class="lab">
          {lab.map((p) => <li><span><strong>{p.name}</strong> <span class="muted">— {p.text}</span></span><span class:list={['tag', p.tag]}>{p.tag}</span></li>)}
        </ul>
      </section>

      <section id="focus">
        <p class="label">What I work on</p>
        <h2>Three layers, one engineer.</h2>
        <div class="stack">
          {services.map((s) => (
            <div class="card">
              <h3>{s.name}</h3>
              <p class="muted">{s.text}</p>
              <div class="chips">{s.chips.map((c) => <span class="chip">{c}</span>)}</div>
            </div>
          ))}
        </div>
        {flags.panelLive && <p class="meta" style="margin-top:16px">Search my name: that Knowledge Panel is my work too.</p>}
      </section>


      <section id="now">
        <p class="label">Now <span class="muted">· updated monthly</span></p>
        <ul class="now">
          <li><span class="mono">Building</span><span id="now-building">{now.building}</span></li>
          <li><span class="mono">Location</span><span>Haryana, India<span id="weather"></span></span></li>
          <li id="np-row"><span class="mono">Playing</span><span id="np">maybe <a class="fav" href="https://smashkarts.io"><img src="/logos/smashkarts.png" alt="" width="14" height="14" loading="lazy" />Smash Karts</a></span></li>
          <li><span class="mono">Shipped</span><span id="shipped">{now.lastShipped}</span></li>
        </ul>
      </section>

      <section id="ask" class="ask">
        <p class="label">Ask DJ</p>
        <h2>Ask anything about my work.</h2>
        <form id="ask-form">
          <label class="skip" for="q">Your question</label>
          <input id="q" name="q" maxlength="300" placeholder="What's the hardest system you've built?" autocomplete="off" required />
          <button class="btn btn-primary" type="submit">Ask</button>
        </form>
        <p class="answer" id="answer" aria-live="polite"></p>
        <p class="mcp muted">Using Claude? Add <code>{site.url}/mcp</code> as an MCP server and ask it about me.</p>
      </section>

      <section id="guestbook" class="guestbook">
        <p class="label">Guestbook</p>
        <h2>Leave a note.</h2>
        <div id="gb-auth"></div>
        <form id="gb-form" hidden>
          <label class="skip" for="gb-msg">Your note</label>
          <input id="gb-msg" name="message" maxlength="280" placeholder="Say hi, share a thought…" autocomplete="off" required />
          <button class="btn btn-primary" type="submit">Sign</button>
        </form>
        <p class="meta" id="gb-err" aria-live="polite"></p>
        <ul class="gb" id="gb-list"></ul>
      </section>

      <section id="contact" class="cta">
        <h2>Hiring engineers who ship?</h2>
        <p class="muted" style="margin-top:10px">I'm looking for SDE and AI engineering roles where I can own systems end to end. I reply within a day.</p>
        <div class="buttons">
          <a class="btn btn-primary" href={mail}>Email me</a>
          <a class="btn btn-secondary" href="/line">Message me directly</a>
          <a class="btn btn-secondary" href={links.cal}>Book a 20-min call</a>
          <a class="btn btn-secondary" href="/resume.pdf" download>Download resume</a>
        </div>
        <p class="meta" style="margin-top:14px">Need something built instead? I take a few freelance projects a year{links.dhivio && <>, or through <a href={links.dhivio}>Dhivio</a></>}. {wa && <a href={wa}>WhatsApp me</a>}</p>
      </section>
    </main>

    <footer>
      <div class="foot">
        <div class="foot-brand">
          <a class="wordmark" href="/" aria-label="Dikshant Jangra, home"><Mark size={24} /></a>
          <p class="foot-name">dikshant jangra</p>
          <p class="muted">Building production software, from {site.location}.</p>
        </div>
        <div class="cols">
          <div><p class="label">Social</p><ul>{[['GitHub', links.github], ['LinkedIn', links.linkedin], ['X', links.x], ['Instagram', links.instagram]].filter(([, u]) => u).map(([n, u]) => <li><a href={u}>{n}</a></li>)}</ul></div>
          <div><p class="label">Site</p><ul><li><a href="#experience">Work</a></li><li><a href="#work">Projects</a></li><li><a href="/line">Direct line</a></li><li><a href="#ask">Ask DJ</a></li><li><a href={links.resume}>Resume</a></li><li><a href="/llms.txt">llms.txt</a></li></ul></div>
          <div><p class="label">Elsewhere</p><ul>{links.dhivio && <li><a href={links.dhivio}>Dhivio</a></li>}<li><a href={links.cal}>Book a call</a></li><li><a href="/resume.pdf" download>Resume PDF</a></li></ul></div>
        </div>
      </div>
      <div class="bottom">
        <span>dikshant jangra © 2026 · updated {site.updated}</span>
        <button class="useless" id="useless" type="button">Don't press this</button>
        <span>{liveCount} products live · 1 trophy · too much chai. made for people who ship.</span>
      </div>
      <ul class="stickers" id="stickers" aria-label="Things from my story">
        {stickers.map(([file, label, href], i) => (
          <li data-label={label} style={`--i:${i};--r:${rot[i % rot.length]}deg;--y:${28 + ((i * 7) % 14)}%`}>
            {href ? <a href={href} aria-label={label}><img src={`/stickers/${file}.png`} alt="" width="72" height="72" loading="lazy" /></a> : <img src={`/stickers/${file}.png`} alt={label} width="72" height="72" loading="lazy" />}
          </li>
        ))}
      </ul>
    </footer>

    {wa && <a class="wa" id="wa" href={wa} aria-label="WhatsApp me">WhatsApp</a>}

    <dialog id="term" class="term" aria-label="Terminal">
      <pre id="term-out"></pre>
      <label class="term-line"><span aria-hidden="true">$</span><input id="term-in" autocomplete="off" spellcheck="false" aria-label="Command" /></label>
    </dialog>

    <dialog id="palette" aria-label="Command menu">
      <input id="cmd-q" placeholder="Type a command…" autocomplete="off" role="combobox" aria-controls="cmd-list" aria-expanded="true" />
      <ul id="cmd-list" role="listbox"></ul>
    </dialog>

    <script>
      import { site, links } from '../data';
      import { annotate } from 'rough-notation';
      import { gridHTML, todayLine, type Activity } from '../github';
      import { toggleSound, blip } from '../scripts/sound';
      import { openTerminal } from '../scripts/terminal';
      import '../scripts/presence';
      import '../scripts/guestbook';
      const $ = (id: string) => document.getElementById(id)!;

      // Every link that leaves this page opens in a new tab (in-page anchors and the GitHub sign-in flow stay put)
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a || !/^https?:/.test(a.protocol) || a.pathname.startsWith('/auth')) return;
        if (a.origin !== location.origin || a.pathname !== location.pathname) Object.assign(a, { target: '_blank', rel: 'noopener' });
      }, true);

      // Clock
      const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' });
      const tick = () => ($('clock').textContent = `Haryana · ${fmt.format(new Date())} IST`);
      tick();
      setInterval(tick, 1000);

      // Theme, with a View Transition where supported
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      $('theme').onclick = () => {
        const flip = () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!.content = dark ? '#0E0E0E' : '#FBFBFA';
        };
        if (!document.startViewTransition || reduce) return flip();
        const r = $('theme').getBoundingClientRect();
        const [x, y] = [r.x + r.width / 2, r.y + r.height / 2];
        const R = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        document.startViewTransition(flip).ready.then(() =>
          document.documentElement.animate({ clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${R}px at ${x}px ${y}px)`] }, { duration: 450, easing: 'ease-out', pseudoElement: '::view-transition-new(root)' }),
        );
      };

      // Hand-drawn highlights, drawn once when visible
      const hlIo = new IntersectionObserver((es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          hlIo.unobserve(e.target);
          const el = e.target as HTMLElement;
          const style = el.classList.contains('mark') ? { type: 'highlight', color: 'rgb(255 90 31 / 0.18)' } : el.classList.contains('thin') ? { type: 'underline', color: 'rgb(255 90 31 / 0.6)', strokeWidth: 1 } : { type: 'underline', color: '#FF5A1F', strokeWidth: 2 };
          annotate(el, { ...style, padding: 1, multiline: true, animate: !reduce, animationDuration: 700 } as Parameters<typeof annotate>[1]).show();
        }),
      { rootMargin: '0px 0px -15% 0px' });
      document.querySelectorAll('.hl').forEach((h) => hlIo.observe(h));

      // Reveal sections once
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))), { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('section').forEach((s) => io.observe(s));
      io.observe($('stickers'));
      const notes = [523, 587, 659, 784, 880];
      document.querySelectorAll('.stickers li').forEach((li, i) => li.addEventListener('pointerenter', () => blip(notes[i % 5] * (i < 9 ? 1 : 2), 60)));
      document.querySelectorAll('.stickers li:not(:has(a))').forEach((li) => li.addEventListener('click', () => li.animate([{ rotate: '0deg' }, { rotate: '-14deg' }, { rotate: '10deg' }, { rotate: '0deg' }], { duration: 420, easing: 'ease-out' })));

      // Floating WhatsApp after hero leaves
      const wa = document.getElementById('wa');
      if (wa) new IntersectionObserver(([e]) => wa.classList.toggle('show', !e.isIntersecting)).observe($('hero'));

      // Useless button
      $('useless').onclick = (e) => {
        const b = e.currentTarget as HTMLButtonElement;
        b.classList.add('pressed');
        b.textContent = 'Told you.';
      };

      // Unique visitors (D1). Counts this browser once, then just reads.
      fetch('/api/views', { method: 'POST' })
        .then((r) => (r.ok ? r.json() : null))
        .then((v) => {
          if (typeof v?.views !== 'number') return;
          $('views-n').textContent = v.views.toLocaleString('en-US');
          $('views').hidden = false;
        })
        .catch(() => {});

      // GitHub: open at today (the right edge), then swap in fresh data
      const ghScroll = $('gh-scroll');
      ghScroll.scrollLeft = ghScroll.scrollWidth;
      fetch('/api/github')
        .then((r) => (r.ok ? r.json() : null))
        .then((g: Activity | null) => {
          if (!g?.days?.length) return;
          $('gh-grid').innerHTML = gridHTML(g);
          $('gh-total').textContent = g.total.toLocaleString('en-US');
          $('gh-today').innerHTML = todayLine(g);
          ghScroll.scrollLeft = ghScroll.scrollWidth;
        })
        .catch(() => {});

      // Live status from KV (set via Telegram)
      fetch('/api/status')
        .then((r) => (r.ok ? r.json() : null))
        .then((s) => {
          if (!s) return;
          if (s.building) $('now-building').textContent = s.building;
        })
        .catch(() => {});

      // Weather (Open-Meteo, no key)
      const sky = (c: number) => (c === 0 ? 'clear' : c < 4 ? 'cloudy' : c < 50 ? 'hazy' : c < 70 ? 'rain' : c < 80 ? 'snow' : 'storms');
      fetch(`https://api.open-meteo.com/v1/forecast?latitude=${site.coords.lat}&longitude=${site.coords.lon}&current=temperature_2m,weather_code`)
        .then((r) => r.json())
        .then(({ current: c }) => ($('weather').textContent = ` · ${Math.round(c.temperature_2m)}°C, ${sky(c.weather_code)}`))
        .catch(() => {});

      // Last shipped: most recently pushed public repo (skipping this site's repo)
      const ago = (d: string) => {
        const m = (Date.now() - Date.parse(d)) / 60000;
        return m < 60 ? `${Math.max(1, Math.round(m))}m ago` : m < 1440 ? `${Math.round(m / 60)}h ago` : `${Math.round(m / 1440)}d ago`;
      };
      const gh = links.github.split('/').pop()!;
      fetch(`https://api.github.com/users/${gh}/repos?sort=pushed&per_page=5`)
        .then((r) => r.json())
        .then((repos) => {
          const r = Array.isArray(repos) && repos.find((x) => x.name.toLowerCase() !== gh.toLowerCase());
          if (r) $('shipped').textContent = `${r.name} · ${ago(r.pushed_at)}`;
        })
        .catch(() => {});

      // Now playing (Lanyard); Smash Karts stays when nothing is live
      if (links.lanyardDiscordId) {
        fetch(`https://api.lanyard.rest/v1/users/${links.lanyardDiscordId}`)
          .then((r) => r.json())
          .then(({ data }) => {
            if (!data?.spotify) return;
            $('np').textContent = `${data.spotify.song} — ${data.spotify.artist}`;
          })
          .catch(() => {});
      }

      // Ask DJ
      $('ask-form').onsubmit = async (e) => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement;
        const q = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
        const out = $('answer');
        const btn = form.querySelector('button')!;
        if (!q) return;
        btn.disabled = true;
        out.textContent = 'Thinking…';
        try {
          const r = await fetch('/api/ask', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ q }) });
          const d = await r.json().catch(() => ({}));
          out.textContent = d.answer || d.error || 'Something broke. Email me instead.';
        } catch {
          out.textContent = 'Something broke. Email me instead.';
        }
        btn.disabled = false;
      };

      // Command palette. Label shows ⌘ on Apple devices, Ctrl elsewhere.
      if (/Mac|iPhone|iPad/.test(navigator.platform)) $('k-mod').textContent = '⌘';
      const dlg = $('palette') as HTMLDialogElement;
      const input = $('cmd-q') as HTMLInputElement;
      const list = $('cmd-list');
      const go = (id: string) => () => document.getElementById(id)?.scrollIntoView();
      const cmds: [string, string, () => void][] = [
        ['Open resume', 'PDF', () => (location.href = links.resume)],
        ['Book a call', 'cal.com', () => (location.href = links.cal)],
        ['Copy email', links.email, () => navigator.clipboard.writeText(links.email)],
        ['Ask DJ a question', 'AI', () => $('q').focus()],
        ['Work', 'jump', go('experience')],
        ['Projects', 'jump', go('work')],
        ['Direct line', 'message me', () => (location.href = '/line')],
        ['What I work on', 'jump', go('focus')],
        ['Contact', 'jump', go('contact')],
        ['Toggle theme', 'light / dark', () => $('theme').click()],
        ['Open terminal', 'press `', openTerminal],
        ['Try the product demo', 'AI', () => $('product').focus()],
        ['Guestbook', 'jump', go('guestbook')],
        ['Toggle sounds', 'off by default', () => toggleSound()],
        ['GitHub', 'open', () => window.open(links.github)],
        ['LinkedIn', 'open', () => window.open(links.linkedin)],
        ...(links.whatsapp ? [['WhatsApp me', 'open', () => window.open(`https://wa.me/${links.whatsapp}`)] as [string, string, () => void]] : []),
      ];
      let shown = cmds;
      let sel = 0;
      const render = () => {
        const f = input.value.toLowerCase();
        shown = cmds.filter(([n]) => n.toLowerCase().includes(f));
        sel = Math.min(sel, Math.max(0, shown.length - 1));
        list.innerHTML = '';
        shown.forEach(([n, hint], i) => {
          const li = document.createElement('li');
          li.role = 'option';
          li.id = `cmd-${i}`;
          li.ariaSelected = String(i === sel);
          li.innerHTML = `<span></span><span class="mono"></span>`;
          li.children[0].textContent = n;
          li.children[1].textContent = hint;
          li.onclick = () => run(i);
          li.onmousemove = () => sel !== i && ((sel = i), render());
          list.append(li);
        });
        input.setAttribute('aria-activedescendant', `cmd-${sel}`);
      };
      const run = (i: number) => {
        const c = shown[i];
        dlg.close();
        c?.[2]();
      };
      const open = () => {
        input.value = '';
        sel = 0;
        render();
        dlg.showModal();
        blip(520);
      };
      $('k').onclick = open;
      input.oninput = () => ((sel = 0), render());
      input.onkeydown = (e) => {
        if (e.key === 'ArrowDown') sel = (sel + 1) % shown.length;
        else if (e.key === 'ArrowUp') sel = (sel - 1 + shown.length) % shown.length;
        else if (e.key === 'Enter') return run(sel);
        else return;
        e.preventDefault();
        render();
      };
      dlg.onclick = (e) => e.target === dlg && dlg.close();
      addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          dlg.open ? dlg.close() : open();
        }
      });
    </script>
  </body>
</html>
